# ==============================================================================
# SECURE FILE VAULT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and update with your actual credentials.
# NOTE: Never commit your actual '.env' file to version control.

# MongoDB Atlas Connection String (Cloud Database - Optional)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
ATLAS_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Local MongoDB URI (Local Fallback Database - Required if not using Atlas)
LOCAL_URI=mongodb://localhost:27017

# Database Name
DB_NAME=secure_file_vault
